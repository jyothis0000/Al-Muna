<style is:global>
  /* ============ motion layer ============ */

  /* reading progress */
  .progress { position: fixed; z-index: 70; left: 0; top: 0; width: 100%; height: 3px; background: #f6e3b0; transform: scaleX(0); transform-origin: left; pointer-events: none; }

  /* header menu: underline draws in on hover */
  .head .nav > ul > li > a { position: relative; }
  .head .nav > ul > li > a::after { content: ''; position: absolute; left: 14px; right: 14px; bottom: 5px; height: 1.5px; background: #f6e3b0; transform: scaleX(0); transform-origin: right; transition: transform 0.4s cubic-bezier(0.3, 0.8, 0.2, 1); }
  .head .nav > ul > li:hover > a::after, .head .nav > ul > li:focus-within > a::after { transform: scaleX(1); transform-origin: left; }

  /* buttons: a soft fill rises from the bottom, and the button lifts */
  .pill { position: relative; overflow: hidden; isolation: isolate; transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.35s cubic-bezier(0.3, 0.8, 0.2, 1); }
  .pill::before { content: ''; position: absolute; z-index: -1; inset: 0; border-radius: inherit; background: rgba(255, 255, 255, 0.2); transform: translateY(102%); transition: transform 0.45s cubic-bezier(0.3, 0.8, 0.2, 1); }
  .pill--line::before, .pill--white::before { background: rgba(0, 88, 41, 0.12); }
  .pill:hover { transform: translateY(-2px); }
  .pill:hover::before { transform: none; }
  .pill:active { transform: translateY(0) scale(0.98); }

  /* headings: word-by-word mask reveal (spans are created by script) */
  #main .display.split.reveal { opacity: 1; transform: none; }
  .sw { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.14em; margin-bottom: -0.14em; }
  .sw > span { display: inline-block; transform: translateY(110%); transition: transform 0.95s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: calc(var(--i) * 45ms); }
  .display.in .sw > span { transform: none; }

  /* stats: the green "Affiliated to" card rises and sharpens into place after the photo, then keeps drifting
     with the scroll (--par is set by script) so it floats in front of the photo */
  #main .stats__photo figcaption { translate: 0 var(--par, 0px); transition: translate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  #main .stats__photo.reveal figcaption { opacity: 0; transform: translateY(34px) scale(0.94); filter: blur(6px); transition: translate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.9s 0.55s, transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.55s, filter 0.9s 0.55s; }
  #main .stats__photo.reveal.in figcaption { opacity: 1; transform: none; filter: none; }
  #main .stats__photo figcaption > * { transition: opacity 0.7s, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
  #main .stats__photo.reveal figcaption > * { opacity: 0; transform: translateY(10px); }
  #main .stats__photo.reveal.in figcaption > * { opacity: 1; transform: none; transition-delay: 0.95s; }
  #main .stats__photo.reveal.in figcaption > :nth-child(2) { transition-delay: 1.05s; }
  #main .stats__photo.reveal.in figcaption > :nth-child(3) { transition-delay: 1.15s; }

  /* stats: the hairline above each figure draws itself */
  #main .stat { position: relative; border-top-color: transparent; }
  #main .stat::before { content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 1px; background: #d9d4c7; transform: scaleX(0); transform-origin: left; transition: transform 1.1s cubic-bezier(0.3, 0.8, 0.2, 1) 0.15s; }
  #main .stat.in::before { transform: none; }

  /* principal's quote: words switch from faint to full as you scroll. No transition, so each word snaps on like typing. */
  .qw { opacity: 0.2; }
  .qw.on { opacity: 1; }
  /* desktop: hold the quote in the middle of the screen while the words fill, so the effect has room to play slowly */
  @media (min-width: 901px) and (prefers-reduced-motion: no-preference) {
    #main .quote { height: 200vh; padding: 0; }
