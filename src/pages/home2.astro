  .cta__card { position: relative; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); column-gap: 56px; padding: 68px 64px 0; border-radius: 32px; overflow: hidden; color: #fff; background: var(--pattern-soft), radial-gradient(120% 150% at 100% 0, #0b7a3f 0, var(--green) 42%, var(--green-dark) 100%); border: 1px solid rgba(255, 255, 255, 0.14); box-shadow: 0 40px 80px rgba(0, 30, 14, 0.35); }
  .cta__card::before { content: ''; position: absolute; width: 560px; aspect-ratio: 1; right: -120px; top: -220px; border-radius: 50%; background: repeating-radial-gradient(circle, transparent 0 40px, rgba(255, 255, 255, 0.07) 40px 41px); pointer-events: none; }
