  /* banner collage follows the pointer slightly (values set by script) */
  .hero__art { --mx: 0; --my: 0; }
  .hero__arch { translate: calc(var(--mx) * 10px) calc(var(--my) * 10px); transition: translate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .hero__float--a { translate: calc(var(--mx) * -26px) calc(var(--my) * -26px); transition: translate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .hero__float--b { translate: calc(var(--mx) * 34px) calc(var(--my) * 34px); transition: translate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .hero__badge { translate: calc(var(--mx) * -44px) calc(var(--my) * -44px); transition: translate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }

  /* tabs photo and panels: gentle zoom under the pointer */
  #main .tabs__panel.is-active .tabs__img:hover img { transform: scale(1.05); transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }

  /* values list: the hovered row steps forward */
  #main .values__list li { transition: opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), padding-left 0.4s cubic-bezier(0.3, 0.8, 0.2, 1), border-color 0.3s; }
