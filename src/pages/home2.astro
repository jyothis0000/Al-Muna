  .values { position: relative; color: #fff; padding: 96px 0; background: linear-gradient(100deg, rgba(0, 53, 25, 0.95) 0, rgba(0, 53, 25, 0.9) 45%, rgba(0, 88, 41, 0.8) 100%), url('/almuna/hero-2.jpg') center / cover no-repeat var(--green); }
